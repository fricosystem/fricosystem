# ==========================================================================
# APEX ERP - variáveis de ambiente do front-end (Vite)
# Copie para `.env` em desenvolvimento. Em produção, cadastre estas mesmas
# chaves em Vercel > Project Settings > Environment Variables.
#
# ATENÇÃO: tudo com prefixo VITE_ é público (vai para o bundle do navegador).
# Segredos de servidor (Groq, token GitHub, Cloudinary API secret) NÃO entram
# aqui - eles ficam no Firebase Secret Manager.
# ==========================================================================

# --- Firebase (chaves públicas; a proteção real são as Firestore Rules + App Check)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Firebase App Check (reCAPTCHA v3 site key). Opcional em dev, obrigatório em prod.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# --- Cloudinary (upload unsigned: NÃO use api_secret no front-end)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_API_KEY=
VITE_CLOUDINARY_UPLOAD_PRESET_PRODUTOS=
VITE_CLOUDINARY_UPLOAD_PRESET_PERFIL=
VITE_CLOUDINARY_UPLOAD_PRESET_MANUAIS=

# --- Supabase (opcional; anon key é pública, protegida por RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
